---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ProcessCards from '../components/ProcessCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { servizi } from '../data/servizi';
import { team } from '../data/team';
import { progetti, progetto } from '../data/progetti';
import { heroSlides, progettiHome, numeriHome, aree } from '../data/contenuti';
import type { Img } from '../lib/media';

const title = 'Campomarzio | architettura, urbanistica, analisi e comunicazione visiva';
const description = site.descrizione;
const fotoStudio: Img = { src: '/img/studio/office.jpg', width: 2550, height: 1700, alt: 'Lo studio Campomarzio — foto di Nicola Cagol' };
---
<Layout title={title} description={description} transparent>
<section class="hero" aria-label="Progetti in evidenza"> <div class="hero-slides" data-hero> {heroSlides.map((s, i) => <figure class:list={['hero-slide', { 'is-active': i === 0 }]} data-title={s.titolo} data-location={s.luogo} data-href={s.href}> <Picture img={s.img} eager={i === 0} class="full-img" /> </figure>)} </div> <div class="container hero-content"> <p class="eyebrow-light mb-3">{site.nome} · {site.attivita} · {site.indirizzo.citta} · {site.sede2.citta}</p> <h1 class="h1">Architettura, urbanistica, <em>analisi e comunicazione visiva</em></h1> <div class="hero-meta"> <div> <p class="lead">Campomarzio è un collettivo transdisciplinare che unisce esperienze pratiche e teoriche, cercando sinergie tra professionisti di campi diversi per un processo creativo in continua evoluzione.</p> <div class="btn-row"> <a href="/progetti/" class="btn btn-primary">Vedi i progetti</a> <a href="/contatti/#richiesta" class="btn btn-outline-light">Contattaci</a> </div> </div> <div class="hero-caption" aria-live="polite"> <span class="label">Nella foto</span> <a href={heroSlides[0].href} class="link-underline" data-hero-caption>{heroSlides[0].titolo} · {heroSlides[0].luogo}</a> <div class="hero-dots" role="group" aria-label="Scegli l'immagine"> {heroSlides.map((s, i) => <button type="button" aria-label={`Mostra ${s.titolo}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>)} </div> </div> </div> </div> </section>

<section class="section"> <div class="container split"> <div class="reveal"> <div class="ratio-45"> <Picture img={fotoStudio} sizes="(min-width: 1024px) 38vw, 92vw" /> </div> </div> <div class="reveal"> <p class="eyebrow mb-2">Lo studio</p> <h2 class="h2">Un collettivo transdisciplinare dal 2012</h2> <div class="prose mt-3 lead"> <p>Uniamo architettura, urbanistica, ricerca e comunicazione visiva in un unico collettivo, cercando sinergie tra professionisti di campi diversi.</p> <p>Fondato a Trento da sei soci, con esperienze accademiche e professionali internazionali: lo studio opera a ogni scala, mantenendo il progetto al centro della ricerca.</p> </div> <div class="stats mt-4"> {numeriHome.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> <a href="/studio/" class="btn btn-outline mt-4">Scopri lo studio</a> </div> </div> </section>

<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Discipline</p> <h2 class="h2">Dall’architettura alla comunicazione visiva</h2> <p class="lead mt-2">Quattro ambiti che si attraversano a ogni scala del progetto.</p> </div> <a href="/servizi/" class="btn btn-outline">Tutte le discipline</a> </div> <ul class="services services-4 reveal"> {servizi.map((s) => <li class="service"> <Icon name={s.icona} class="icon" /> <h3 class="h4"><a href={`/servizi/#${s.id}`} class="link-underline">{s.nome}</a></h3> <p>{s.breve}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Premi</p> <h2 class="h2">Premi e riconoscimenti</h2> </div> <a href="/metodo/" class="text-link link-underline">Tutti i premi</a> </div> <ProcessCards /> </div> </section>

<section class="section" style="padding-top: 0"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Progetti</p> <h2 class="h2">Opere costruite, concorsi e ricerca</h2> </div> <a href="/progetti/" class="text-link link-underline">Tutti i {progetti.length} progetti</a> </div> <div class="projects-grid"> {progettiHome.map((slug) => <ProjectCard p={progetto(slug)} />)} </div> </div> </section>

<section class="section bg-ink"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Dove lavoriamo</p> <h2 class="h2">Dal Trentino all’Alto Adige e oltre</h2> <p class="lead mt-2" style="color: rgb(255 255 255 / 0.72)">Due sedi, a Trento e Bolzano, e progetti in tutto il Trentino-Alto Adige e oltre confine. Il conteggio segue i progetti pubblicati.</p> </div> </div> <ul class="areas reveal"> {aree.map((a) => <li class="area"> <span>{a.conteggio}</span> <strong>{a.nome}</strong> <p>{a.comuni}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Soci</p> <h2 class="h2">Le persone dello studio</h2> <p class="lead mt-2">Sei soci fondatori e una collaboratrice, con una rete di professionisti di campi diversi.</p> </div> <a href="/studio/#team" class="text-link link-underline">Conosci lo studio</a> </div> <div class="team-strip reveal"> {team.slice(0, 7).map((m) => <a href={`/studio/#${m.id}`} title={`${m.nome}, ${m.ruolo}`}> <Picture img={m.foto} sizes="(min-width: 768px) 14vw, 33vw" /> </a>)} </div> </div> </section>


<section class="section"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Dove siamo</p> <h2 class="h2">{site.nome} a {site.indirizzo.citta} e {site.sede2.citta}</h2> <p class="lead mt-3">Due sedi: nel centro di Trento e a Bolzano. Scrivici per fissare un incontro.</p> <div class="contact-cards mt-4"> <div class="contact-card"> <h3>Trento</h3> <p>{site.indirizzo.via}<br>{site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia})</p> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline mt-1" style="display:inline-block">Apri in Google Maps</a> </div> <div class="contact-card"> <h3>Bolzano</h3> <p>{site.sede2.via}<br>{site.sede2.cap} {site.sede2.citta}</p> <a href={site.sede2.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline mt-1" style="display:inline-block">Apri in Google Maps</a> </div> <div class="contact-card"> <h3>Contatti</h3> {site.telefono && <p><a href={`tel:${site.telefonoE164}`}>{site.telefono}</a></p>} <p><a href={`mailto:${site.email}`}>{site.email}</a></p> </div> </div> </div> <div class="map reveal"> <MapEmbed span={0.012} /> </div> </div> </section>
<Cta />
<script>
var e=document.querySelector(`[data-hero]`);if(e){let t=[...e.querySelectorAll(`.hero-slide`)],n=[...document.querySelectorAll(`[data-dot]`)],r=document.querySelector(`[data-hero-caption]`),i=window.matchMedia(`(prefers-reduced-motion: reduce)`).matches,a=0,o,s=e=>{t[a].classList.remove(`is-active`),n[a].setAttribute(`aria-current`,`false`),a=(e+t.length)%t.length;let i=t[a];i.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)),i.classList.add(`is-active`),n[a].setAttribute(`aria-current`,`true`),r&&(r.textContent=`${i.dataset.title} · ${i.dataset.location}`,r.href=i.dataset.href||`#`)},c=()=>{i||(o=window.setInterval(()=>s(a+1),6e3))};n.forEach((e,t)=>e.addEventListener(`click`,()=>{window.clearInterval(o),s(t),c()})),window.addEventListener(`load`,()=>t.forEach(e=>e.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)))),c()}
</script>
</Layout>
