---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import { progetto } from '../data/progetti';
import { numeriStudio, approccio, competenzeStudio } from '../data/contenuti';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Studio', href: '/studio/' }];
const hero = progetto('torri-madonna-bianca').immagini[0];
const foto = [progetto('piazza-della-mostra').immagini[0], progetto('house-ca').immagini[0]];
---
<Layout title="Studio | Campomarzio, collettivo transdisciplinare a Trento" description="Campomarzio è un collettivo transdisciplinare di Trento fondato nel 2012 da sei soci, che unisce architettura, urbanistica, ricerca e comunicazione visiva." pageType="AboutPage" ogType="article" transparent crumbs={crumbs}>
<PageHero img={hero} crumbs={crumbs} eyebrow="Studio"> <h1 class="h1-page">Un collettivo <em>transdisciplinare</em></h1> <p class="lead">Sei soci, due sedi tra Trento e Bolzano e una rete di professionisti di campi diversi.</p> </PageHero>
<section class="section"> <div class="container split"> <div class="reveal"> <p class="eyebrow mb-2">Lo studio</p> <h2 class="h2">Campomarzio</h2> </div> <div class="prose lead reveal"> <p>Campomarzio è un collettivo transdisciplinare che unisce esperienze pratiche e teoriche nei campi dell’architettura, dell’urbanistica, della ricerca e della comunicazione visiva.</p> <p>Fondato nel 2012 da Pietro V. Ambrosini, Michele Andreatta, Alessandro Busana, Daniele Cappelletti, Enrico Lunelli e Teresa Pedretti, è nato con l’obiettivo di superare i confini disciplinari. Grazie alla pluralità dei soci e a esperienze accademiche e professionali internazionali, lo studio opera in differenti ambiti e scale, mantenendo costantemente il progetto al centro della propria ricerca.</p> <p>Campomarzio ha vinto numerosi premi in concorsi nazionali e internazionali, ha partecipato alla 14ª e 16ª Biennale di Architettura di Venezia e ha collaborato con l’Università di Trento, lo IUAV di Venezia e il MIT di Boston.</p> </div> </div> <div class="container mt-4"> <div class="stats reveal"> {numeriStudio.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> </div> </section>
<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Approccio</p> <h2 class="h2">Come lavoriamo</h2> </div> </div> <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.5rem"> {approccio.map((a, i) => <div class="reveal border-top" style={`padding-top:1.5rem; transition-delay:${i * 80}ms`}> <p class="eyebrow mb-2">{String(i + 1).padStart(2, '0')}</p> <h3 class="h3 mb-2">{a.titolo}</h3> <p>{a.testo}</p> </div>)} </div> <div class="grid-2 mt-4"> {foto.map((f) => <div class="ratio-32 reveal"><Picture img={f} sizes="(min-width: 1024px) 45vw, 92vw" /></div>)} </div> </div> </section>
<section class="section" id="team"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Soci e collaboratori</p> <h2 class="h2">Le persone di {site.nome}</h2> <p class="lead mt-2">I sei soci fondatori e la collaboratrice dello studio. Campomarzio lavora inoltre con una rete di professionisti di campi diversi.</p> </div> </div> <ul class="team-grid"> {team.map((m, i) => <li class="member reveal" id={m.id} style={`transition-delay:${(i % 4) * 60}ms`}> <div class="photo"><Picture img={m.foto} sizes="(min-width: 1100px) 22vw, (min-width: 768px) 30vw, 46vw" /></div> <h3>{m.nome}</h3> <p>{m.ruolo}</p> {m.bio && <p style="text-transform:none; letter-spacing:0; color:var(--text); font-size:.9375rem; font-weight:400; line-height:1.6; margin-top:.9rem">{m.bio}</p>} {m.email && <p style="text-transform:none; letter-spacing:0; margin-top:.5rem; font-size:.9375rem"><a href={`mailto:${m.email}`} class="link-underline">{m.email}</a></p>} </li>)} </ul> </div> </section>
<section class="section bg-sand"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Sedi</p> <h2 class="h2">{site.indirizzo.citta} e {site.sede2.citta}</h2> <p class="lead mt-3">{site.indirizzo.via}, {site.indirizzo.cap} {site.indirizzo.citta} — {site.sede2.via}, {site.sede2.cap} {site.sede2.citta}.</p> <div class="btn-row mt-4"> <a href="/contatti/" class="btn btn-primary">Contatti</a> <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-outline">Indicazioni per Trento</a> </div> </div> <div class="reveal"> <ul class="checklist lead"> {competenzeStudio.map((c) => <li>{c}</li>)} </ul> </div> </div> </section>
<Cta />
</Layout>
